@model List<GEPS.Models.Evento>
@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Eventos";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-calendar-event"></i> Eventos
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Gestión de eventos del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin:0;">
                <i class="bi bi-list-ul"></i> Lista de eventos
            </h5>
            <a href="/Lider/CrearEvento"
               style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <i class="bi bi-plus-circle"></i> Nuevo evento
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px; color:#aaa;">
                <i class="bi bi-calendar-event" style="font-size:48px; display:block; margin-bottom:12px;"></i>
                <p style="font-size:14px;">No hay eventos registrados aún.</p>
                <a href="/Lider/CrearEvento"
                   style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:12px;">
                    <i class="bi bi-plus-circle"></i> Crear primer evento
                </a>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Nombre</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Fecha</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Lugar</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Tipo</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Organizador</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var proyectosEvento = (ViewBag.Proyectos as List<GEPS.Models.Proyecto>)
                            .Where(p => e.Proyectos.Contains(p.Id)).ToList();

                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:14px 16px; font-weight:600; color:#0d2f5e;">
                                @e.Nombre
                                @if (proyectosEvento.Any())
                                {
                                    <div style="font-size:11px; color:#aaa; font-weight:400; margin-top:2px;">
                                        <i class="bi bi-kanban"></i> @string.Join(", ", proyectosEvento.Select(p => p.Titulo))
                                    </div>
                                }
                            </td>
                            <td style="padding:14px 16px; color:#555;">@e.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="padding:14px 16px; color:#555;">@e.Lugar</td>
                            <td style="padding:14px 16px;">
                                <span style="background:#e8f4fd; color:#1a5276; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600;">
                                    @e.Tipo
                                </span>
                            </td>
                            <td style="padding:14px 16px; color:#555;">@e.NombreOrganizador</td>
                            <td style="padding:14px 16px; text-align:center;">
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a href="/Lider/EditarEvento/@e.Id"
                                       style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a href="/Lider/CambiarEstadoEvento/@e.Id"
                                       style="background:@(e.Activo ? "linear-gradient(90deg,#922b21,#e74c3c)" : "linear-gradient(90deg,#1e8449,#27ae60)"); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;"
                                       onclick="return confirm('@(e.Activo ? "¿Deshabilitar este evento?" : "¿Habilitar este evento?")')">
                                        <i class="bi @(e.Activo ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                        @(e.Activo ? "Deshabilitar" : "Habilitar")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
