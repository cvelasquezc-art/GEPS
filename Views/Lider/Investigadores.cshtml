@model List<GEPS.Models.Usuario>
@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Investigadores";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-people"></i> Investigadores
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Gestión de investigadores del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin:0;">
                <i class="bi bi-list-ul"></i> Lista de investigadores
            </h5>
            <a href="/Lider/CrearInvestigador"
               style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <i class="bi bi-person-plus"></i> Nuevo investigador
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px; color:#aaa;">
                <i class="bi bi-people" style="font-size:48px; display:block; margin-bottom:12px;"></i>
                <p style="font-size:14px;">No hay investigadores registrados aún.</p>
                <a href="/Lider/CrearInvestigador"
                   style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:12px;">
                    <i class="bi bi-person-plus"></i> Crear primer investigador
                </a>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Nombre</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Cédula</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Correo</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Programa</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Estado</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0; transition:background 0.15s;">
                            <td style="padding:14px 16px; font-weight:600; color:#0d2f5e;">
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div style="width:34px; height:34px; background:#fef9e7; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <i class="bi bi-person" style="color:#d4ac0d; font-size:16px;"></i>
                                    </div>
                                    @inv.Nombre
                                </div>
                            </td>
                            <td style="padding:14px 16px; color:#555;">@inv.Cedula</td>
                            <td style="padding:14px 16px; color:#555;">@inv.Correo</td>
                            <td style="padding:14px 16px; color:#555;">@(string.IsNullOrEmpty(inv.Programa) ? "—" : inv.Programa)</td>
                            <td style="padding:14px 16px; text-align:center;">
                                @if (inv.Activo)
                                {
                                    <span style="background: #d5f5e3; color: #1e8449; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 4px;">
                                        <i class="bi bi-check-circle"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span style="background: #fde8e8; color: #c0392b; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 4px;">
                                        <i class="bi bi-x-circle"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td style="padding:14px 16px; text-align:center;">
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a href="/Lider/EditarInvestigador/@inv.Id"
                                       style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a href="/Lider/CambiarEstadoInvestigador/@inv.Id"
                                       style="background:@(inv.Activo ? "linear-gradient(90deg,#922b21,#e74c3c)" : "linear-gradient(90deg,#1e8449,#27ae60)"); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;"
                                       onclick="return confirm('@(inv.Activo ? "¿Desactivar este investigador?" : "¿Activar este investigador?")')">
                                        <i class="bi @(inv.Activo ? "bi-person-dash" : "bi-person-check")"></i>
                                        @(inv.Activo ? "Desactivar" : "Activar")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
