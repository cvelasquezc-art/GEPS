@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Reporte PDF";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-file-earmark-pdf"></i> Reporte PDF
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Visualiza y descarga el reporte completo de tu semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <!-- Tarjeta principal -->
    <div style="background:white; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; max-width:700px;">

        <div style="display:flex; align-items:center; gap:20px; margin-bottom:28px;">
            <div style="width:64px; height:64px; background:#fde8e8; border-radius:16px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <i class="bi bi-file-earmark-pdf" style="font-size:30px; color:#e74c3c;"></i>
            </div>
            <div>
                <h5 style="font-size:16px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
                    Reporte completo del semillero
                </h5>
                <p style="font-size:13px; color:#888; margin:0;">
                    Incluye información del semillero, investigadores, proyectos, fases, reuniones y eventos.
                </p>
            </div>
        </div>

        <!-- Resumen de contenido -->
        <div style="background:#f0f4f8; border-radius:12px; padding:20px; margin-bottom:28px;">
            <div style="font-size:12px; font-weight:700; color:#1a5276; text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;">
                Contenido del reporte
            </div>
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-people" style="font-size:20px; color:#d4ac0d; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Investigadores as List<GEPS.Models.Usuario>)?.Count ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Investigadores</div>
                </div>

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-kanban" style="font-size:20px; color:#1a5276; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Proyectos as List<GEPS.Models.Proyecto>)?.Count ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Proyectos</div>
                </div>

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-camera-video" style="font-size:20px; color:#4fc3a1; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Reuniones as List<GEPS.Models.Reunion>)?.Count ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Reuniones</div>
                </div>

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-calendar-event" style="font-size:20px; color:#e74c3c; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Eventos as List<GEPS.Models.Evento>)?.Count ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Eventos</div>
                </div>

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-diagram-2" style="font-size:20px; color:#1e8449; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Proyectos as List<GEPS.Models.Proyecto>)?.Sum(p => p.Fases.Count) ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Fases</div>
                </div>

                <div style="background:white; border-radius:10px; padding:14px; text-align:center;">
                    <i class="bi bi-list-task" style="font-size:20px; color:#0d2f5e; display:block; margin-bottom:6px;"></i>
                    <div style="font-size:20px; font-weight:900; color:#0d2f5e;">
                        @((ViewBag.Proyectos as List<GEPS.Models.Proyecto>)?.Sum(p => p.Fases.Sum(f => f.Actividades.Count)) ?? 0)
                    </div>
                    <div style="font-size:11px; color:#888; margin-top:2px;">Actividades</div>
                </div>

            </div>
        </div>

        <!-- Botones -->
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
            <a href="/Lider/DescargarReporte" target="_blank"
               style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:12px 24px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:8px; text-decoration:none;">
                <i class="bi bi-eye"></i> Ver reporte
            </a>
            <a href="/Lider/DescargarReporte?descargar=true"
               style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:12px 24px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:8px; text-decoration:none;">
                <i class="bi bi-download"></i> Descargar PDF
            </a>
        </div>

    </div>
</div>
