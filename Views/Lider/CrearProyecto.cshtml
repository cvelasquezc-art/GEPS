@model GEPS.Models.Proyecto
@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Crear Proyecto";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-plus-circle"></i> Crear proyecto
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Registrar un nuevo proyecto para el semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; max-width:600px;">

        @if (ViewBag.Error != null)
        {
            <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
                <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
            </div>
        }

        <form action="/Lider/CrearProyecto" method="post" class="form-geps" novalidate>
            @Html.AntiForgeryToken()

            <label>Título del proyecto *</label>
            <input type="text"
                   name="Titulo"
                   id="inputTitulo"
                   placeholder="Ej: Proyecto TIC"
                   value="@(Model?.Titulo)" />
            <div id="tituloFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>

            <label>Objetivo *</label>
            <textarea name="Objetivo"
                      id="inputObjetivo"
                      rows="3"
                      placeholder="Describe el objetivo principal del proyecto...">@(Model?.Objetivo)</textarea>
            <div id="objetivoFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>

            <label>Duración (meses)</label>
            <input type="number"
                   name="DuracionMeses"
                   min="1"
                   max="60"
                   placeholder="Ej: 6"
                   value="@(Model?.DuracionMeses > 0 ? Model.DuracionMeses.ToString() : "")" />

            <div style="background:#d5f5e3; border-radius:10px; padding:12px 16px; font-size:13px; color:#1e8449; margin-bottom:20px; border-left:4px solid #1e8449;">
                <i class="bi bi-info-circle"></i>
                El proyecto se creará con estado <strong>En ejecución</strong> automáticamente.
            </div>

            <div style="display:flex; gap:12px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-check-lg"></i> Crear proyecto
                </button>
                <a href="/Lider/Proyectos"
                   style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        var titulo      = document.getElementById('inputTitulo');
        var tituloFb    = document.getElementById('tituloFeedback');
        var objetivo    = document.getElementById('inputObjetivo');
        var objetivoFb  = document.getElementById('objetivoFeedback');

        if (titulo.value.trim() === '') {
            e.preventDefault();
            tituloFb.textContent = 'El título es obligatorio.';
            tituloFb.style.display = 'block';
        } else {
            tituloFb.style.display = 'none';
        }

        if (objetivo.value.trim() === '') {
            e.preventDefault();
            objetivoFb.textContent = 'El objetivo es obligatorio.';
            objetivoFb.style.display = 'block';
        } else {
            objetivoFb.style.display = 'none';
        }
    });
</script>

