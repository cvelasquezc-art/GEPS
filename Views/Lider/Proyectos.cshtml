@model List<GEPS.Models.Proyecto>
@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Proyectos";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-kanban"></i> Proyectos
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Gestión de proyectos del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin:0;">
                <i class="bi bi-list-ul"></i> Lista de proyectos
            </h5>
            <a href="/Lider/CrearProyecto"
               style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <i class="bi bi-plus-circle"></i> Nuevo proyecto
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px; color:#aaa;">
                <i class="bi bi-kanban" style="font-size:48px; display:block; margin-bottom:12px;"></i>
                <p style="font-size:14px;">No hay proyectos registrados aún.</p>
                <a href="/Lider/CrearProyecto"
                   style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:12px;">
                    <i class="bi bi-plus-circle"></i> Crear primer proyecto
                </a>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Título</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Objetivo</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Duración</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Fases</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Estado</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0; transition:background 0.15s;">
                            <td style="padding:14px 16px; font-weight:600; color:#0d2f5e;">@p.Titulo</td>
                            <td style="padding:14px 16px; color:#555; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@p.Objetivo</td>
                            <td style="padding:14px 16px; color:#555; text-align:center;">@p.DuracionMeses mes(es)</td>
                            <td style="padding:14px 16px; text-align:center;">
                                <span style="background:#e8f4fd; color:#1a5276; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                    @p.Fases.Count fase(s)
                                </span>
                            </td>
                            <td style="padding:14px 16px; text-align:center;">
                                @if (p.Estado == "En ejecución")
                                {
                                    <span style="background:#d5f5e3; color:#1e8449; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-play-circle"></i> En ejecución
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#fde8e8; color:#c0392b; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-check-circle"></i> Terminado
                                    </span>
                                }
                            </td>
                            <td style="padding:14px 16px; text-align:center;">
                                <div style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">
                                    <a href="/Lider/DetalleProyecto/@p.Id"
                                       style="background:linear-gradient(90deg,#1a5276,#4fc3a1); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    <a href="/Lider/EditarProyecto/@p.Id"
                                       style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <button onclick="abrirCambioEstado('@p.Id', '@p.Estado')"
                                            style="background:@(p.Estado == "En ejecución" ? "linear-gradient(90deg,#922b21,#e74c3c)" : "linear-gradient(90deg,#1e8449,#27ae60)"); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                                        <i class="bi @(p.Estado == "En ejecución" ? "bi-stop-circle" : "bi-play-circle")"></i>
                                        @(p.Estado == "En ejecución" ? "Terminar" : "Reactivar")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Modal cambiar estado -->
<div id="modalEstado" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:16px; padding:32px; width:100%; max-width:420px; box-shadow:0 20px 60px rgba(0,0,0,0.2);">
        <h5 style="font-size:16px; font-weight:700; color:#0d2f5e; margin-bottom:12px;">
            <i class="bi bi-arrow-repeat"></i> Cambiar estado del proyecto
        </h5>
        <p id="modalEstadoTexto" style="font-size:13px; color:#666; margin-bottom:20px;"></p>
        <form id="formEstado" action="/Lider/CambiarEstadoProyecto" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="hiddenIdProyecto" name="id" />
            <input type="hidden" id="hiddenEstado" name="estado" />
            <div style="display:flex; gap:12px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer;">
                    Confirmar
                </button>
                <button type="button" onclick="cerrarModalEstado()"
                        style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer;">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirCambioEstado(id, estadoActual) {
        var nuevoEstado = estadoActual === 'En ejecución' ? 'Terminado' : 'En ejecución';
        document.getElementById('hiddenIdProyecto').value = id;
        document.getElementById('hiddenEstado').value     = nuevoEstado;
        document.getElementById('modalEstadoTexto').textContent =
            estadoActual === 'En ejecución'
                ? '¿Marcar este proyecto como Terminado?'
                : '¿Reactivar este proyecto a En ejecución?';
        document.getElementById('modalEstado').style.display = 'flex';
    }

    function cerrarModalEstado() {
        document.getElementById('modalEstado').style.display = 'none';
    }

    window.addEventListener('click', function(e) {
        if (e.target === document.getElementById('modalEstado')) cerrarModalEstado();
    });
</script>
