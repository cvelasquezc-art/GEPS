@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Crear Reunión";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-camera-video"></i> Crear reunión
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Programar una nueva reunión del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; max-width:600px;">

        @if (ViewBag.Error != null)
        {
            <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
                <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
            </div>
        }

        @Html.ValidationSummary(true, "Por favor completa todos los campos requeridos:", new { @class = "validation-summary", style = "background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;" })

        <form action="/Lider/CrearReunion" method="post" class="form-geps" novalidate>
            @Html.AntiForgeryToken()

            <label>Motivo de la reunión *</label>
            <input type="text" name="Motivo" id="inputMotivo"
                   placeholder="Ej: Revisión de avances del proyecto" required />
            @Html.ValidationMessageFor(m => m.Motivo)

            <label>Proyecto relacionado *</label>
            <select name="IdProyecto" id="inputProyecto" required>
                <option value="">-- Selecciona un proyecto --</option>
                @foreach (var p in ViewBag.Proyectos as List<GEPS.Models.Proyecto>)
                {
                    <option value="@p.Id">@p.Titulo</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.IdProyecto)

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label>Fecha *</label>
                    <input type="date" name="Fecha" required />
                    @Html.ValidationMessageFor(m => m.Fecha)
                </div>
                <div>
                    <label>Hora *</label>
                    <input type="time" name="Hora" required />
                    @Html.ValidationMessageFor(m => m.Hora)
                </div>
            </div>

            <label>Lugar *</label>
            <input type="text" name="Lugar" placeholder="Ej: Sala 1, Virtual, etc." required />
            @Html.ValidationMessageFor(m => m.Lugar)

            <label>Enlace (opcional)</label>
            <input type="text" name="Enlace" placeholder="Ej: https://meet.google.com/..." />

            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-check-lg"></i> Crear reunión
                </button>
                <a href="/Lider/Reuniones"
                   style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    // Validación HTML5 nativa más ModelState del servidor manejan la validación
</script>
