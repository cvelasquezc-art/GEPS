@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Crear Evento";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-calendar-event"></i> Crear evento
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Registrar un nuevo evento del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; max-width:600px;">

        @if (ViewBag.Error != null)
        {
            <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
                <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
            </div>
        }

        @Html.ValidationSummary(true, "Por favor completa todos los campos requeridos:", new { @class = "validation-summary", style = "background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;" })

        <form action="/Lider/CrearEvento" method="post" class="form-geps" novalidate>
            @Html.AntiForgeryToken()

            <label>Nombre del evento *</label>
            <input type="text" name="Nombre" id="inputNombre"
                   placeholder="Ej: Congreso TIC 2026" required />
            @Html.ValidationMessageFor(m => m.Nombre)

            <label>Proyecto relacionado *</label>
            <select name="idProyecto" id="inputProyecto" required>
                <option value="">-- Selecciona un proyecto --</option>
                @foreach (var p in ViewBag.Proyectos as List<GEPS.Models.Proyecto>)
                {
                    <option value="@p.Id">@p.Titulo</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.Proyectos)

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label>Fecha *</label>
                    <input type="date" name="Fecha" required />
                    @Html.ValidationMessageFor(m => m.Fecha)
                </div>
                <div>
                    <label>Tipo *</label>
                    <select name="Tipo" required>
                        <option value="">-- Selecciona --</option>
                        <option value="Ponencia">Ponencia</option>
                        <option value="Exposición">Exposición</option>
                        <option value="Congreso">Congreso</option>
                        <option value="Seminario">Seminario</option>
                        <option value="Taller">Taller</option>
                        <option value="Otro">Otro</option>
                    </select>
                    @Html.ValidationMessageFor(m => m.Tipo)
                </div>
            </div>

            <label>Lugar *</label>
            <input type="text" name="Lugar" placeholder="Ej: Bogotá, Auditorio SENA" required />
            @Html.ValidationMessageFor(m => m.Lugar)

            <label>Nombre del organizador *</label>
            <input type="text" name="NombreOrganizador"
                   placeholder="Ej: Universidad Nacional" required />
            @Html.ValidationMessageFor(m => m.NombreOrganizador)

            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-check-lg"></i> Crear evento
                </button>
                <a href="/Lider/Eventos"
                   style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    // Validación HTML5 nativa más ModelState del servidor manejan la validación
</script>
