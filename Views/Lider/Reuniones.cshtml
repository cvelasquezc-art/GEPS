@model List<GEPS.Models.Reunion>
@{
    Layout = "~/Views/Shared/_LayoutLider.cshtml";
    ViewBag.Title = "Reuniones";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-camera-video"></i> Reuniones
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Gestión de reuniones del semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

<div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin:0;">
            <i class="bi bi-list-ul"></i> Lista de reuniones
        </h5>
        <a href="/Lider/CrearReunion"
           style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
            <i class="bi bi-plus-circle"></i> Nueva reunión
        </a>
    </div>

    <!-- Filtros -->
    <div style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap; align-items:end;">
        <div>
            <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:4px;">Día</label>
            <select id="filtroDia" onchange="aplicarFiltrosReuniones()" style="padding:8px 12px; border:1.5px solid #e8e8e8; border-radius:8px; font-size:13px;">
                <option value="">Todos</option>
                @for (int d = 1; d <= 31; d++)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </div>
        <div>
            <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:4px;">Mes</label>
            <select id="filtroMes" onchange="aplicarFiltrosReuniones()" style="padding:8px 12px; border:1.5px solid #e8e8e8; border-radius:8px; font-size:13px;">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
        </div>
        <div>
            <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:4px;">Año</label>
            <select id="filtroAnio" onchange="aplicarFiltrosReuniones()" style="padding:8px 12px; border:1.5px solid #e8e8e8; border-radius:8px; font-size:13px;">
                <option value="">Todos</option>
                @{
                    var aniosReuniones = Model.Select(r => r.Fecha.Year).Distinct().OrderByDescending(y => y).ToList();
                }
                @foreach (var anio in aniosReuniones)
                {
                    <option value="@anio">@anio</option>
                }
            </select>
        </div>
        <button onclick="limpiarFiltrosReuniones()"
                style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:8px 14px; font-size:13px; font-weight:600; cursor:pointer; height:38px;">
            <i class="bi bi-x-circle"></i> Limpiar
        </button>
    </div>

    <div id="sinResultadosReuniones" style="display:none; text-align:center; padding:40px 20px; color:#aaa;">
        <i class="bi bi-search" style="font-size:36px; display:block; margin-bottom:8px;"></i>
        <p style="font-size:14px;">No hay reuniones que coincidan con el filtro.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div style="text-align:center; padding:60px 20px; color:#aaa;">
            <i class="bi bi-camera-video" style="font-size:48px; display:block; margin-bottom:12px;"></i>
            <p style="font-size:14px;">No hay reuniones registradas aún.</p>
            <a href="/Lider/CrearReunion"
               style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:12px;">
                <i class="bi bi-plus-circle"></i> Crear primera reunión
            </a>
        </div>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse; font-size:13px;">
            <thead>
                <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Motivo</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Fecha</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Hora</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Lugar</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Enlace</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Estado</th>
                    <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var proyecto = (ViewBag.Proyectos as List<GEPS.Models.Proyecto>)
                        .FirstOrDefault(p => p.Id == r.IdProyecto);
                    <tr class="fila-reunion"
                        data-dia="@r.Fecha.Day"
                        data-mes="@r.Fecha.Month"
                        data-anio="@r.Fecha.Year"
                        style="border-bottom:1px solid #f0f0f0;">
                        <td style="padding:14px 16px; font-weight:600; color:#0d2f5e;">
                            @r.Motivo
                            @if (proyecto != null)
                            {
                                <div style="font-size:11px; color:#aaa; font-weight:400; margin-top:2px;">
                                    <i class="bi bi-kanban"></i> @proyecto.Titulo
                                </div>
                            }
                        </td>
                        <td style="padding:14px 16px; color:#555;">@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td style="padding:14px 16px; color:#555;">@r.Hora</td>
                        <td style="padding:14px 16px; color:#555;">@r.Lugar</td>
                        <td style="padding:14px 16px;">
                            @if (!string.IsNullOrEmpty(r.Enlace))
                            {
                                <a href="@r.Enlace" target="_blank"
                                   style="color:#1a5276; font-size:12px; display:inline-flex; align-items:center; gap:4px;">
                                    <i class="bi bi-link-45deg"></i> Unirse
                                </a>
                            }
                            else
                            {
                                <span style="color:#ccc; font-size:12px;">—</span>
                            }
                        </td>
                        <td style="padding:14px 16px; text-align:center;">
                            @if (r.Estado == "Programada")
                            {
                                <span style="background:#e8f4fd; color:#1a5276; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                    <i class="bi bi-clock"></i> Programada
                                </span>
                            }
                            else if (r.Estado == "En ejecución")
                            {
                                <span style="background:#d5f5e3; color:#1e8449; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                    <i class="bi bi-play-circle"></i> En ejecución
                                </span>
                            }
                            else
                            {
                                <span style="background:#f0f0f0; color:#888; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                    <i class="bi bi-check-circle"></i> Finalizada
                                </span>
                            }
                        </td>
                        <td style="padding:14px 16px; text-align:center;">
                            <div style="display:flex; gap:6px; justify-content:center;">
                                <a href="/Lider/EditarReunion/@r.Id"
                                   style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a href="/Lider/CambiarEstadoReunion/@r.Id"
                                   style="background:@(r.Activo ? "linear-gradient(90deg,#922b21,#e74c3c)" : "linear-gradient(90deg,#1e8449,#27ae60)"); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;"
                                   onclick="return confirm('@(r.Activo ? "¿Deshabilitar esta reunión?" : "¿Habilitar esta reunión?")')">
                                    <i class="bi @(r.Activo ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                    @(r.Activo ? "Deshabilitar" : "Habilitar")
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</div>

<script>
    function aplicarFiltrosReuniones() {
        var dia = document.getElementById('filtroDia').value;
        var mes = document.getElementById('filtroMes').value;
        var anio = document.getElementById('filtroAnio').value;

        var filas = document.querySelectorAll('.fila-reunion');
        var visibles = 0;

        filas.forEach(function (fila) {
            var coincide = true;

            if (dia !== '' && fila.dataset.dia !== dia) coincide = false;
            if (mes !== '' && fila.dataset.mes !== mes) coincide = false;
            if (anio !== '' && fila.dataset.anio !== anio) coincide = false;

            fila.style.display = coincide ? '' : 'none';
            if (coincide) visibles++;
        });

        var sinResultados = document.getElementById('sinResultadosReuniones');
        if (sinResultados) {
            sinResultados.style.display = visibles === 0 ? 'block' : 'none';
        }
    }

    function limpiarFiltrosReuniones() {
        document.getElementById('filtroDia').value = '';
        document.getElementById('filtroMes').value = '';
        document.getElementById('filtroAnio').value = '';
        aplicarFiltrosReuniones();
    }
</script>