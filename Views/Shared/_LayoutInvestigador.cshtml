<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GEPS – @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f0f4f8;
            min-height: 100vh;
        }

        .navbar-geps {
            background: linear-gradient(90deg, #0d2f5e 0%, #1a5276 60%, #1e8449 100%);
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 12px rgba(0,0,0,0.2);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

            .navbar-brand .logo-circle {
                width: 36px;
                height: 36px;
                background: rgba(255,255,255,0.15);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.25);
            }

                .navbar-brand .logo-circle i {
                    font-size: 18px;
                    color: #4fc3a1;
                }

            .navbar-brand .brand-text {
                font-size: 20px;
                font-weight: 900;
                color: white;
                letter-spacing: 2px;
            }

                .navbar-brand .brand-text span {
                    color: #4fc3a1;
                }

        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
            margin: 0 auto;
            padding: 0;
        }

            .navbar-menu a {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 14px;
                border-radius: 8px;
                color: rgba(255,255,255,0.8);
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: background 0.2s, color 0.2s;
                white-space: nowrap;
            }

                .navbar-menu a:hover {
                    background: rgba(255,255,255,0.12);
                    color: white;
                }

                .navbar-menu a.active {
                    background: rgba(255,255,255,0.18);
                    color: white;
                }

                .navbar-menu a i {
                    font-size: 15px;
                }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.25);
        }

            .user-avatar i {
                font-size: 16px;
                color: white;
            }

        .user-name {
            font-size: 13px;
            color: rgba(255,255,255,0.85);
            font-weight: 500;
            white-space: nowrap;
        }

        .btn-salir {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px;
            color: rgba(255,255,255,0.85);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }

            .btn-salir:hover {
                background: rgba(220,53,69,0.5);
                color: white;
                border-color: transparent;
            }

            .btn-salir i {
                font-size: 14px;
            }

        .main-content {
            padding: 32px;
            max-width: 1200px;
            margin: 0 auto;
        }
    </style>
</head>
<body>

    <nav class="navbar-geps">

        <a href="/Investigador/Index" class="navbar-brand">
            <div class="logo-circle"><i class="bi bi-flower2"></i></div>
            <span class="brand-text">GEP<span>S</span></span>
        </a>

        <ul class="navbar-menu">
            <li>
                <a href="/Investigador/Index"
                   class="@(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Panel
                </a>
            </li>
            <li>
                <a href="/Investigador/Semillero"
                   class="@(ViewContext.RouteData.Values["action"].ToString() == "Semillero" ? "active" : "")">
                    <i class="bi bi-diagram-3"></i> Mi Semillero
                </a>
            </li>
            <li>
                <a href="/Investigador/Proyectos"
                   class="@(ViewContext.RouteData.Values["action"].ToString().Contains("Proyecto") ? "active" : "")">
                    <i class="bi bi-kanban"></i> Proyectos
                </a>
            </li>
            <li>
                <a href="/Investigador/Reuniones"
                   class="@(ViewContext.RouteData.Values["action"].ToString() == "Reuniones" ? "active" : "")">
                    <i class="bi bi-camera-video"></i> Reuniones
                </a>
            </li>
            <li>
                <a href="/Investigador/Eventos"
                   class="@(ViewContext.RouteData.Values["action"].ToString() == "Eventos" ? "active" : "")">
                    <i class="bi bi-calendar-event"></i> Eventos
                </a>
            </li>
        </ul>

        <div class="navbar-right">
            <div class="user-info">
                <div class="user-avatar"><i class="bi bi-person"></i></div>
                <span class="user-name">@Session["Nombre"]</span>
            </div>
            <form id="formSalir" action="/Investigador/Salir" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="button" class="btn-salir" onclick="confirmarSalir()">
                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                </button>
            </form>
        </div>

    </nav>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    function confirmarSalir() {
        if (confirm('¿Estás seguro que deseas cerrar sesión?')) {
            document.getElementById('formSalir').submit();
        }
    }
    </script>
</body>
</html>
