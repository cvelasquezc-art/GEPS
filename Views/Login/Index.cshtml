@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GEPS – Iniciar sesión</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(145deg, #0d2f5e 0%, #1a5276 50%, #1e8449 100%);
        }

        .panel-left {
            width: 45%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 48px;
            position: relative;
            overflow: hidden;
        }

            .panel-left::before {
                content: '';
                position: absolute;
                top: -80px;
                right: -80px;
                width: 250px;
                height: 250px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
            }

            .panel-left::after {
                content: '';
                position: absolute;
                bottom: -60px;
                left: -60px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: rgba(255,255,255,0.04);
            }

        .dots {
            position: absolute;
            z-index: 0;
            opacity: 0.1;
        }

        .dots-tl {
            top: 30px;
            left: 30px;
        }

        .dots-br {
            bottom: 30px;
            right: 30px;
        }

        .dot-grid {
            display: grid;
            grid-template-columns: repeat(5, 8px);
            gap: 8px;
        }

            .dot-grid span {
                width: 4px;
                height: 4px;
                border-radius: 50%;
                background: white;
                display: block;
            }

        .panel-left-content {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .brand-logo {
            width: 90px;
            height: 90px;
            background: rgba(255,255,255,0.12);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            border: 2px solid rgba(255,255,255,0.2);
        }

            .brand-logo i {
                font-size: 42px;
                color: #4fc3a1;
            }

        .brand-title {
            font-size: 58px;
            font-weight: 900;
            color: white;
            letter-spacing: 4px;
            line-height: 1;
        }

            .brand-title span {
                color: #4fc3a1;
            }

        .brand-subtitle {
            color: rgba(255,255,255,0.7);
            font-size: 14px;
            margin-top: 8px;
            letter-spacing: 0.5px;
        }

        .brand-divider {
            width: 48px;
            height: 3px;
            background: #4fc3a1;
            border-radius: 2px;
            margin: 20px auto;
        }

        .brand-desc {
            color: rgba(255,255,255,0.6);
            font-size: 14px;
            line-height: 1.7;
            max-width: 280px;
            margin: 0 auto;
        }

        .panel-right {
            width: 55%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 48px;
        }

        .form-card {
            background: white;
            border-radius: 20px;
            padding: 48px 44px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        }

        .form-icon {
            width: 56px;
            height: 56px;
            background: #eaf4f0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
        }

            .form-icon i {
                font-size: 24px;
                color: #1e8449;
            }

        .form-welcome {
            font-size: 13px;
            color: #999;
            text-align: center;
            margin-bottom: 2px;
        }

        .form-title {
            font-size: 34px;
            font-weight: 900;
            color: #0d2f5e;
            text-align: center;
            margin-bottom: 4px;
        }

        .form-divider {
            width: 36px;
            height: 3px;
            background: #4fc3a1;
            border-radius: 2px;
            margin: 0 auto 8px;
        }

        .form-subtitle {
            font-size: 13px;
            color: #aaa;
            text-align: center;
            margin-bottom: 28px;
        }

        .field-label {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 6px;
            display: block;
        }

        .input-wrap {
            position: relative;
            margin-bottom: 6px;
        }

            .input-wrap i.icon-left {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #bbb;
                font-size: 16px;
                pointer-events: none;
            }

            .input-wrap input {
                width: 100%;
                padding: 12px 40px;
                border: 1.5px solid #e8e8e8;
                border-radius: 10px;
                font-size: 14px;
                color: #333;
                background: #fafafa;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            }

                .input-wrap input:focus {
                    outline: none;
                    border-color: #1a5276;
                    background: white;
                    box-shadow: 0 0 0 3px rgba(26,82,118,0.08);
                }

                .input-wrap input.is-invalid {
                    border-color: #dc3545;
                    background: #fff8f8;
                    box-shadow: 0 0 0 3px rgba(220,53,69,0.08);
                }

                .input-wrap input.is-valid {
                    border-color: #198754;
                    background: #f8fff8;
                    box-shadow: 0 0 0 3px rgba(25,135,84,0.08);
                }

        .btn-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #bbb;
            font-size: 16px;
            cursor: pointer;
            padding: 0;
        }

            .btn-toggle:hover {
                color: #666;
            }

        .feedback-msg {
            font-size: 12px;
            color: #dc3545;
            margin-top: 4px;
            display: none;
        }

        .counter-text {
            font-size: 11px;
            color: #ccc;
            text-align: right;
            margin-top: 3px;
        }

        .forgot-row {
            text-align: right;
            margin: 4px 0 20px;
        }

            .forgot-row a {
                font-size: 12px;
                color: #1a5276;
                text-decoration: none;
            }

                .forgot-row a:hover {
                    text-decoration: underline;
                }

        .btn-ingresar {
            width: 100%;
            height: 50px;
            background: linear-gradient(90deg, #0d2f5e 0%, #1a5276 60%, #1e8449 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s;
        }

            .btn-ingresar:hover {
                opacity: 0.9;
                transform: translateY(-1px);
            }

            .btn-ingresar:active {
                transform: translateY(0);
            }

        .field-group {
            margin-bottom: 16px;
        }
    </style>
</head>
<body>

    <div class="panel-left">

        <div class="dots dots-tl">
            <div class="dot-grid">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>

        <div class="dots dots-br">
            <div class="dot-grid">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </div>

        <div class="panel-left-content">
            <div class="brand-logo">
                <i class="bi bi-flower2"></i>
            </div>
            <div class="brand-title">GEP<span>S</span></div>
            <div class="brand-subtitle">Gestión Eficiente para Semilleros</div>
            <div class="brand-divider"></div>
            <p class="brand-desc">
                Plataforma para la gestión, seguimiento y desarrollo de semilleros de investigación.
            </p>
        </div>
    </div>

    <div class="panel-right">
        <div class="form-card">

            <div class="form-icon">
                <i class="bi bi-person"></i>
            </div>

            <p class="form-welcome">Bienvenido a</p>
            <h1 class="form-title">GEPS</h1>
            <div class="form-divider"></div>
            <p class="form-subtitle">Inicia sesión para continuar</p>
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success"
                     style="border-radius:10px; font-size:13px; padding:10px 14px; margin-bottom:16px;">
                    @TempData["Exito"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger"
                     style="border-radius:10px; font-size:13px; padding:10px 14px; margin-bottom:16px;">
                    @ViewBag.Error
                </div>
            }

            <form id="loginForm" action="/Login/Index" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div class="field-group">
                    <label class="field-label">Cédula</label>
                    <div class="input-wrap">
                        <i class="bi bi-person icon-left"></i>
                        <input type="text"
                               id="inputCedula"
                               name="cedula"
                               placeholder="Ingresa tu cédula"
                               maxlength="10"
                               autocomplete="off" />
                    </div>
                    <div id="cedulaFeedback" class="feedback-msg"></div>
                    <div class="counter-text"><span id="contador">0</span>/10 dígitos</div>
                    @if (ViewBag.CedulaError != null)
                    {
                        <div style="font-size:12px; color:#dc3545; margin-top:4px;">@ViewBag.CedulaError</div>
                    }
                </div>

                <div class="field-group">
                    <label class="field-label">Contraseña</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock icon-left"></i>
                        <input type="password"
                               id="inputClave"
                               name="clave"
                               placeholder="Ingresa tu contraseña" />
                        <button type="button" class="btn-toggle" onclick="togglePassword()">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <div id="claveFeedback" class="feedback-msg"></div>
                </div>

                <div class="forgot-row">
                    <a href="/Login/OlvideContrasena">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn-ingresar">
                    Iniciar sesión <i class="bi bi-arrow-right"></i>
                </button>

            </form>
        </div>
    </div>

    <script>
        const inputCedula = document.getElementById("inputCedula");
        const cedulaFb = document.getElementById("cedulaFeedback");
        const contador = document.getElementById("contador");
        const inputClave = document.getElementById("inputClave");
        const claveFb = document.getElementById("claveFeedback");

        function showError(input, fb, msg) {
            input.classList.add("is-invalid");
            input.classList.remove("is-valid");
            fb.textContent = "⚠️ " + msg;
            fb.style.display = "block";
        }

        function clearError(input, fb) {
            input.classList.remove("is-invalid");
            input.classList.remove("is-valid");
            fb.textContent = "";
            fb.style.display = "none";
        }

        function markValid(input, fb) {
            input.classList.remove("is-invalid");
            input.classList.add("is-valid");
            fb.style.display = "none";
        }

        inputCedula.addEventListener("keypress", function (e) {
            if (!/[0-9]/.test(e.key)) {
                e.preventDefault();
                showError(inputCedula, cedulaFb, "Solo se permiten números en este campo.");
            }
        });

        inputCedula.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "");
            contador.textContent = this.value.length;
            if (this.value.length === 10) markValid(inputCedula, cedulaFb);
            else clearError(inputCedula, cedulaFb);
        });

        inputCedula.addEventListener("blur", function () {
            if (this.value.length > 0 && this.value.length < 10)
                showError(inputCedula, cedulaFb, "La cédula debe tener exactamente 10 dígitos.");
        });

        inputClave.addEventListener("input", function () {
            if (this.value.trim() !== "") clearError(inputClave, claveFb);
        });

        function togglePassword() {
            const eye = document.getElementById("eyeIcon");
            if (inputClave.type === "password") {
                inputClave.type = "text";
                eye.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                inputClave.type = "password";
                eye.classList.replace("bi-eye-slash", "bi-eye");
            }
        }

        document.getElementById("loginForm").addEventListener("submit", function (e) {
            if (!/^\d{10}$/.test(inputCedula.value)) {
                e.preventDefault();
                showError(inputCedula, cedulaFb, "La cédula debe tener exactamente 10 dígitos numéricos.");
                inputCedula.focus();
            }
            if (inputClave.value.trim() === "") {
                e.preventDefault();
                showError(inputClave, claveFb, "La contraseña es obligatoria.");
            }
        });
    </script>

</body>
</html>