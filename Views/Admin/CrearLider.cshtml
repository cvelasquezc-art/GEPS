@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Crear Líder";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-person-plus"></i> Crear líder
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Registrar credenciales para un nuevo líder de semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; max-width:640px;">

        @if (ViewBag.Error != null)
        {
            <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
                <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
            </div>
        }

        <div style="background:#e8f4fd; border-radius:10px; padding:14px 16px; font-size:13px; color:#1a5276; margin-bottom:24px; border-left:4px solid #1a5276;">
            <i class="bi bi-info-circle"></i>
            La contraseña se genera automáticamente con el formato <strong>GEPS + últimos 4 dígitos de la cédula</strong> y se envía al correo del líder.
        </div>

        <form action="/Admin/CrearLider" method="post" class="form-geps" novalidate>
            @Html.AntiForgeryToken()

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label>Nombre completo *</label>
                    <input type="text" name="nombre" id="inputNombre"
                           placeholder="Ej: Ana García" />
                    <div id="nombreFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>
                </div>
                <div>
                    <label>Cédula *</label>
                    <input type="text" name="cedula" id="inputCedula"
                           placeholder="10 dígitos" maxlength="10" />
                    <div id="cedulaFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:4px; display:none;"></div>
                    <div style="font-size:11px; color:#bbb; margin-bottom:12px; text-align:right;">
                        <span id="contador">0</span>/10 dígitos
                    </div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label>Correo electrónico *</label>
                    <input type="email" name="correo" id="inputCorreo"
                           placeholder="Ej: ana@gmail.com" />
                    <div id="correoFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>
                </div>
                <div>
                    <label>Celular</label>
                    <input type="text" name="celular"
                           placeholder="Ej: 3001234567" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <label>Fecha de nacimiento</label>
                    <input type="date" name="fechaNacimiento" />
                </div>
                <div>
                    <label>Género</label>
                    <select name="genero">
                        <option value="">-- Selecciona --</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
            </div>

            <label>Programa académico</label>
            <input type="text" name="programa"
                   placeholder="Ej: Ingeniería de Sistemas" />

            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-check-lg"></i> Crear líder
                </button>
                <a href="/Admin/Lideres"
                   style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </div>

        </form>
    </div>
</div>

<script>
    var inputCedula = document.getElementById('inputCedula');
    var contador = document.getElementById('contador');
    var cedulaFb = document.getElementById('cedulaFeedback');

    inputCedula.addEventListener('keypress', function (e) {
        if (e.key < '0' || e.key > '9') {
            e.preventDefault();
            cedulaFb.textContent = 'Solo se permiten numeros.';
            cedulaFb.style.display = 'block';
        }
    });

    inputCedula.addEventListener('input', function () {
        var val = this.value.replace(/[^0-9]/g, '');
        this.value = val;
        contador.textContent = val.length;
        if (val.length === 10) {
            cedulaFb.style.display = 'none';
            this.style.borderColor = '#1e8449';
        } else {
            this.style.borderColor = '#e8e8e8';
        }
    });

    inputCedula.addEventListener('blur', function () {
        if (this.value.length > 0 && this.value.length < 10) {
            cedulaFb.textContent = 'La cedula debe tener exactamente 10 digitos.';
            cedulaFb.style.display = 'block';
        }
    });

    document.querySelector('form').addEventListener('submit', function (e) {
        var valido = true;
        var nombre = document.getElementById('inputNombre');
        var nombreFb = document.getElementById('nombreFeedback');
        var correo = document.getElementById('inputCorreo');
        var correoFb = document.getElementById('correoFeedback');
        var at = String.fromCharCode(64);

        if (nombre.value.trim() === '') {
            e.preventDefault();
            nombreFb.textContent = 'El nombre es obligatorio.';
            nombreFb.style.display = 'block';
            valido = false;
        } else {
            nombreFb.style.display = 'none';
        }

        if (inputCedula.value.length !== 10) {
            e.preventDefault();
            cedulaFb.textContent = 'La cedula debe tener exactamente 10 digitos.';
            cedulaFb.style.display = 'block';
            valido = false;
        }

        if (correo.value.trim() === '' || correo.value.indexOf(at) === -1) {
            e.preventDefault();
            correoFb.textContent = 'Ingresa un correo valido.';
            correoFb.style.display = 'block';
            valido = false;
        } else {
            correoFb.style.display = 'none';
        }
    });
</script>

