@model List<GEPS.Models.Semillero>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Reporte PDF";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-file-earmark-pdf"></i> Reporte PDF
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Visualiza y descarga reportes de semilleros</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">

        <!-- Reporte completo -->
        <div style="background:white; border-radius:16px; padding:28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">
            <div style="width:48px; height:48px; background:#fde8e8; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="bi bi-file-earmark-pdf" style="font-size:22px; color:#e74c3c;"></i>
            </div>
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:8px;">
                Reporte completo
            </h5>
            <p style="font-size:13px; color:#888; margin-bottom:20px; line-height:1.6;">
                Visualiza o descarga el reporte con todos los semilleros registrados en el sistema.
            </p>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <a href="/Admin/DescargarReporte" target="_blank"
                   style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                    <i class="bi bi-eye"></i> Ver reporte (@Model.Count semilleros)
                </a>
                <a href="/Admin/DescargarReporte?descargar=true"
                   style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                    <i class="bi bi-download"></i> Descargar
                </a>
            </div>
        </div>

        <!-- Reporte por semillero -->
        <div style="background:white; border-radius:16px; padding:28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">
            <div style="width:48px; height:48px; background:#e8f4fd; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="bi bi-funnel" style="font-size:22px; color:#1a5276;"></i>
            </div>
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:8px;">
                Reporte por semillero
            </h5>
            <p style="font-size:13px; color:#888; margin-bottom:20px; line-height:1.6;">
                Selecciona un semillero específico para ver o descargar solo su información.
            </p>

            @if (Model.Count == 0)
            {
                <p style="font-size:13px; color:#aaa;">No hay semilleros registrados.</p>
            }
            else
            {
                <div style="margin-bottom:12px;">
                    <label style="font-size:12px; font-weight:600; color:#555; margin-bottom:6px; display:block;">
                        Seleccionar semillero
                    </label>
                    <select id="selectSemillero"
                            style="width:100%; padding:10px 14px; border:1.5px solid #e8e8e8; border-radius:8px; font-size:13px; color:#333; background:#fafafa;">
                        @foreach (var s in Model)
                        {
                            <option value="@s.Id">@s.Nombre — @(s.Activo ? "Activo" : "Inactivo")</option>
                        }
                    </select>
                </div>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <button onclick="verReporte()"
                            style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; cursor:pointer;">
                        <i class="bi bi-eye"></i> Ver reporte
                    </button>
                    <button onclick="descargarReporte()"
                            style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; cursor:pointer;">
                        <i class="bi bi-download"></i> Descargar
                    </button>
                </div>
            }
        </div>

    </div>

    <!-- Vista previa de semilleros -->
    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; margin-top:20px;">
        <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:20px;">
            <i class="bi bi-eye"></i> Vista previa de semilleros
        </h5>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:40px; color:#aaa;">
                <i class="bi bi-inbox" style="font-size:40px; display:block; margin-bottom:12px;"></i>
                <p>No hay semilleros registrados.</p>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Nombre</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Línea investigativa</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Fecha creación</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Estado</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0; transition:background 0.15s;">
                            <td style="padding:12px 16px; font-weight:600; color:#0d2f5e;">@s.Nombre</td>
                            <td style="padding:12px 16px; color:#555;">@s.LineaInvestigativa</td>
                            <td style="padding:12px 16px; color:#666;">@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px; text-align:center;">
                                @if (s.Activo)
                                {
                                    <span style="background:#d5f5e3; color:#1e8449; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-check-circle"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#fde8e8; color:#c0392b; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-x-circle"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td style="padding:12px 16px; text-align:center;">
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a href="/Admin/DescargarReporte?idSemillero=@s.Id" target="_blank"
                                       style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    <a href="/Admin/DescargarReporte?idSemillero=@s.Id&descargar=true"
                                       style="background:linear-gradient(90deg,#922b21,#e74c3c); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-download"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    function verReporte() {
        var id = document.getElementById('selectSemillero').value;
        window.open('/Admin/DescargarReporte?idSemillero=' + id, '_blank');
    }

    function descargarReporte() {
        var id = document.getElementById('selectSemillero').value;
        window.location.href = '/Admin/DescargarReporte?idSemillero=' + id + '&descargar=true';
    }
</script>

