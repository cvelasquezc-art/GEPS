@model GEPS.Models.Semillero
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Editar Semillero";
}

<div class="page-header">
    <h2><i class="bi bi-pencil"></i> Editar Semillero</h2>
    <p>Modificar datos del semillero</p>
    <div class="divider"></div>
</div>

<div class="card-geps" style="max-width:600px;">

    @if (ViewBag.Error != null)
    {
        <div class="alert-geps-danger">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

<form action="/Admin/EditarSemillero" method="post" class="form-geps" novalidate id="formEditarSemillero">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Nombre del semillero</label>
    <input type="text"
           name="Nombre"
           id="inputNombre"
           placeholder="Ej: InvesTIC"
           value="@Model.Nombre" />
    <div id="nombreFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>

    <label>Línea investigativa</label>
    <input type="text"
           name="LineaInvestigativa"
           id="inputLinea"
           placeholder="Ej: Tecnología e Innovación"
           value="@Model.LineaInvestigativa" />
    <div id="lineaFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>

    <label>Descripción</label>
    <textarea name="Descripcion"
              id="inputDescripcion"
              rows="3"
              placeholder="Descripción del semillero...">@Model.Descripcion</textarea>
    <div id="descripcionFeedback" style="font-size:12px; color:#c0392b; margin-top:-12px; margin-bottom:12px; display:none;"></div>

    <div style="display:flex; gap:12px; margin-top:8px;">
        <button type="submit" class="btn-primary-geps">
            <i class="bi bi-check-lg"></i> Guardar cambios
        </button>
        <a href="/Admin/Semilleros" class="btn-danger-geps">
            <i class="bi bi-x-lg"></i> Cancelar
        </a>
    </div>

</form>
</div>

<script>
    var inputNombre = document.getElementById('inputNombre');
    var nombreFb = document.getElementById('nombreFeedback');

    var inputLinea = document.getElementById('inputLinea');
    var lineaFb = document.getElementById('lineaFeedback');

    var inputDescripcion = document.getElementById('inputDescripcion');
    var descripcionFb = document.getElementById('descripcionFeedback');

    var soloLetras = /^[A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]*$/;

    inputNombre.addEventListener('keypress', function (e) {
        if (!soloLetras.test(e.key)) {
            e.preventDefault();
            nombreFb.textContent = 'Solo se permiten letras y espacios.';
            nombreFb.style.display = 'block';
        }
    });

    inputNombre.addEventListener('input', function () {
        var val = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]/g, '');
        this.value = val;
        if (val.trim() !== '') {
            nombreFb.style.display = 'none';
            this.style.borderColor = '#1e8449';
        } else {
            this.style.borderColor = '#e8e8e8';
        }
    });

    inputLinea.addEventListener('keypress', function (e) {
        if (!soloLetras.test(e.key)) {
            e.preventDefault();
            lineaFb.textContent = 'Solo se permiten letras y espacios.';
            lineaFb.style.display = 'block';
        }
    });

    inputLinea.addEventListener('input', function () {
        var val = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]/g, '');
        this.value = val;
        if (val.trim() !== '') {
            lineaFb.style.display = 'none';
            this.style.borderColor = '#1e8449';
        } else {
            this.style.borderColor = '#e8e8e8';
        }
    });

    inputDescripcion.addEventListener('keypress', function (e) {
        if (!soloLetras.test(e.key)) {
            e.preventDefault();
            descripcionFb.textContent = 'Solo se permiten letras y espacios.';
            descripcionFb.style.display = 'block';
        }
    });

    inputDescripcion.addEventListener('input', function () {
        var val = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]/g, '');
        this.value = val;
        if (val.trim() !== '') {
            descripcionFb.style.display = 'none';
            this.style.borderColor = '#1e8449';
        } else {
            this.style.borderColor = '#e8e8e8';
        }
    });
</script>

