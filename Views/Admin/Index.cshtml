@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Panel Administrador";
}

<div style="padding: 8px 0 24px;">

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    <!-- Bienvenida -->
    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            Bienvenido, @Session["Nombre"] 👋
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">
            Panel de administración — GEPS
        </p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <!-- Tarjetas de resumen -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:32px;">

        <div style="background:white; border-radius:16px; padding:28px 24px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
            <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(26,82,118,0.06);"></div>
            <div style="width:48px; height:48px; background:#e8f4fd; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="bi bi-diagram-3" style="font-size:22px; color:#1a5276;"></i>
            </div>
            <div style="font-size:36px; font-weight:900; color:#0d2f5e; line-height:1;">@ViewBag.TotalSemilleros</div>
            <div style="font-size:13px; color:#888; margin-top:6px;">Total semilleros</div>
        </div>

        <div style="background:white; border-radius:16px; padding:28px 24px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
            <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(30,132,73,0.06);"></div>
            <div style="width:48px; height:48px; background:#d5f5e3; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="bi bi-check-circle" style="font-size:22px; color:#1e8449;"></i>
            </div>
            <div style="font-size:36px; font-weight:900; color:#1e8449; line-height:1;">@ViewBag.SemillerosActivos</div>
            <div style="font-size:13px; color:#888; margin-top:6px;">Semilleros activos</div>
        </div>

        <div style="background:white; border-radius:16px; padding:28px 24px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
            <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(212,172,13,0.06);"></div>
            <div style="width:48px; height:48px; background:#fef9e7; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
                <i class="bi bi-person-badge" style="font-size:22px; color:#d4ac0d;"></i>
            </div>
            <div style="font-size:36px; font-weight:900; color:#d4ac0d; line-height:1;">@ViewBag.TotalLideres</div>
            <div style="font-size:13px; color:#888; margin-top:6px;">Líderes registrados</div>
        </div>

    </div>

    <!-- Acciones rápidas -->
    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">
        <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:6px;">
            <i class="bi bi-lightning-charge"></i> Acciones rápidas
        </h5>
        <p style="font-size:12px; color:#aaa; margin-bottom:20px;">
            Gestiona y administra tu información de forma rápida y sencilla
        </p>

        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px;">

            <a href="/Admin/CrearSemillero"
               style="background:linear-gradient(135deg,#0d2f5e,#1a5276); border-radius:12px; padding:20px 16px; text-decoration:none; display:flex; flex-direction:column; gap:10px;">
                <div style="width:38px; height:38px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-plus-circle" style="font-size:18px; color:white;"></i>
                </div>
                <div>
                    <div style="font-size:13px; font-weight:700; color:white;">Nuevo semillero</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.65); margin-top:2px;">Registrar un nuevo semillero</div>
                </div>
            </a>

            <a href="/Admin/CrearLider"
               style="background:linear-gradient(135deg,#1e8449,#27ae60); border-radius:12px; padding:20px 16px; text-decoration:none; display:flex; flex-direction:column; gap:10px;">
                <div style="width:38px; height:38px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-person-plus" style="font-size:18px; color:white;"></i>
                </div>
                <div>
                    <div style="font-size:13px; font-weight:700; color:white;">Crear líder</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.65); margin-top:2px;">Registrar un nuevo líder</div>
                </div>
            </a>

            <a href="/Admin/Semilleros"
               style="background:linear-gradient(135deg,#b7770d,#d4ac0d); border-radius:12px; padding:20px 16px; text-decoration:none; display:flex; flex-direction:column; gap:10px;">
                <div style="width:38px; height:38px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-diagram-3" style="font-size:18px; color:white;"></i>
                </div>
                <div>
                    <div style="font-size:13px; font-weight:700; color:white;">Ver semilleros</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.65); margin-top:2px;">Consultar semilleros registrados</div>
                </div>
            </a>

            <a href="/Admin/Reporte"
               style="background:linear-gradient(135deg,#922b21,#e74c3c); border-radius:12px; padding:20px 16px; text-decoration:none; display:flex; flex-direction:column; gap:10px;">
                <div style="width:38px; height:38px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-file-earmark-pdf" style="font-size:18px; color:white;"></i>
                </div>
                <div>
                    <div style="font-size:13px; font-weight:700; color:white;">Reporte PDF</div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.65); margin-top:2px;">Descargar reporte completo</div>
                </div>
            </a>

        </div>
    </div>

</div>