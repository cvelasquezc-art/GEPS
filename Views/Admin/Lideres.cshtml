@model List<GEPS.Models.Usuario>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Líderes";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-person-badge"></i> Líderes
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Gestión de líderes de semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div style="background:#fde8e8; color:#c0392b; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #c0392b;">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin:0;">
                <i class="bi bi-list-ul"></i> Lista de líderes
            </h5>
            <a href="/Admin/CrearLider"
               style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <i class="bi bi-person-plus"></i> Crear líder
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px; color:#aaa;">
                <i class="bi bi-people" style="font-size:48px; display:block; margin-bottom:12px;"></i>
                <p style="font-size:14px;">No hay líderes registrados aún.</p>
                <a href="/Admin/CrearLider"
                   style="background:linear-gradient(90deg,#1e8449,#27ae60); color:white; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none; margin-top:12px;">
                    <i class="bi bi-person-plus"></i> Crear primer líder
                </a>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276);">
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left; border-radius:8px 0 0 0;">Nombre</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Cédula</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:left;">Correo</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Estado</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center;">Semillero</th>
                        <th style="padding:12px 16px; color:white; font-weight:600; text-align:center; border-radius:0 8px 0 0;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lider in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0; transition:background 0.15s;">
                            <td style="padding:14px 16px; font-weight:600; color:#0d2f5e;">
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div style="width:34px; height:34px; background:#e8f4fd; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <i class="bi bi-person" style="color:#1a5276; font-size:16px;"></i>
                                    </div>
                                    @lider.Nombre
                                </div>
                            </td>
                            <td style="padding:14px 16px; color:#555;">@lider.Cedula</td>
                            <td style="padding:14px 16px; color:#555;">@lider.Correo</td>
                            <td style="padding:14px 16px; text-align:center;">
                                @if (lider.Activo)
                                {
                                    <span style="background:#d5f5e3; color:#1e8449; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-check-circle"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#fde8e8; color:#c0392b; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-x-circle"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td style="padding:14px 16px; text-align:center;">
                                @if (string.IsNullOrEmpty(lider.IdSemillero))
                                {
                                    <span style="background:#fef9e7; color:#d4ac0d; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-clock"></i> Sin asignar
                                    </span>
                                }
                                else
                                {
                                    var semilleroAsignado = (ViewBag.Semilleros as List<GEPS.Models.Semillero>)
                                        .FirstOrDefault(s => s.Id == lider.IdSemillero);
                                    <span style="background:#d5f5e3; color:#1e8449; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
                                        <i class="bi bi-check-circle"></i> @(semilleroAsignado != null ? semilleroAsignado.Nombre : "Asignado")
                                    </span>
                                }
                            </td>
                            <td style="padding:14px 16px; text-align:center;">
                                <div style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap;">

                                    <!-- Asignar semillero -->
                                    <button data-id="@lider.Id" data-nombre="@lider.Nombre"
                                            onclick="abrirAsignar(this.dataset.id, this.dataset.nombre)"
                                            style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                                        <i class="bi bi-link-45deg"></i> Asignar
                                    </button>

                                    <!-- Editar -->
                                    <a href="/Admin/EditarLider/@lider.Id"
                                       style="background:linear-gradient(90deg,#b7770d,#d4ac0d); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>

                                    <!-- Desactivar / Activar -->
                                    <a href="/Admin/CambiarEstadoLider/@lider.Id"
                                       style="background:@(lider.Activo ? "linear-gradient(90deg,#922b21,#e74c3c)" : "linear-gradient(90deg,#1e8449,#27ae60)"); color:white; border:none; border-radius:7px; padding:6px 10px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; text-decoration:none;"
                                       onclick="return confirm('@(lider.Activo ? "¿Desactivar este líder?" : "¿Activar este líder?")')">
                                        <i class="bi @(lider.Activo ? "bi-person-dash" : "bi-person-check")"></i>
                                        @(lider.Activo ? "Desactivar" : "Activar")
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Modal asignar semillero -->
<div id="modalAsignar" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:16px; padding:32px; width:100%; max-width:460px; box-shadow:0 20px 60px rgba(0,0,0,0.2);">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h5 style="font-size:16px; font-weight:700; color:#0d2f5e; margin:0;">
                <i class="bi bi-link-45deg"></i> Asignar semillero
            </h5>
            <button onclick="cerrarModal()" style="background:none; border:none; font-size:20px; color:#aaa; cursor:pointer;">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <p id="modalTexto" style="font-size:13px; color:#666; margin-bottom:20px;"></p>

        <form action="/Admin/AsignarLider" method="post" class="form-geps">
            @Html.AntiForgeryToken()
            <input type="hidden" id="hiddenIdLider" name="idLider" />

            <label>Seleccionar semillero</label>
            <select name="idSemillero" id="selectSemillero">
                <option value="">-- Selecciona un semillero --</option>
                @foreach (var s in ViewBag.Semilleros as List<GEPS.Models.Semillero>)
                {
                    <option value="@s.Id">@s.Nombre — @s.LineaInvestigativa</option>
                }
            </select>

            <div style="display:flex; gap:12px; margin-top:8px;">
                <button type="submit"
                        style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-check-lg"></i> Asignar
                </button>
                <button type="button" onclick="cerrarModal()"
                        style="background:white; color:#555; border:1.5px solid #e8e8e8; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer;">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirAsignar(idLider, nombre) {
        document.getElementById('hiddenIdLider').value = idLider;
        document.getElementById('modalTexto').textContent = 'Asignando semillero a: ' + nombre;
        document.getElementById('modalAsignar').style.display = 'flex';
    }

    function cerrarModal() {
        document.getElementById('modalAsignar').style.display = 'none';
    }

    window.addEventListener('click', function (e) {
        const modal = document.getElementById('modalAsignar');
        if (e.target === modal) cerrarModal();
    });
</script>
