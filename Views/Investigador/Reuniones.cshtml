@model List<GEPS.Models.Reunion>
@{
    Layout = "~/Views/Shared/_LayoutInvestigador.cshtml";
    ViewBag.Title = "Reuniones";
    var proyectos = ViewBag.Proyectos as List<GEPS.Models.Proyecto>;
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-camera-video"></i> Reuniones
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Reuniones programadas para los proyectos de tu semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:24px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px;">
                <div style="width:64px; height:64px; background:#f0f4f8; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                    <i class="bi bi-camera-video" style="font-size:28px; color:#aaa;"></i>
                </div>
                <p style="font-size:14px; color:#aaa; margin:0;">No hay reuniones programadas en tu semillero.</p>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white;">
                        <th style="padding:12px 16px; font-weight:600; border-radius:8px 0 0 0;">Motivo</th>
                        <th style="padding:12px 16px; font-weight:600;">Proyecto</th>
                        <th style="padding:12px 16px; font-weight:600;">Fecha</th>
                        <th style="padding:12px 16px; font-weight:600;">Hora</th>
                        <th style="padding:12px 16px; font-weight:600;">Lugar</th>
                        <th style="padding:12px 16px; font-weight:600; border-radius:0 8px 0 0;">Enlace</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var proyecto = proyectos?.FirstOrDefault(p => p.Id == r.IdProyecto);
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:12px 16px; color:#0d2f5e; font-weight:600;">@r.Motivo</td>
                            <td style="padding:12px 16px; color:#555;">@(proyecto != null ? proyecto.Titulo : "—")</td>
                            <td style="padding:12px 16px; color:#666;">@r.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px; color:#666;">@r.Hora</td>
                            <td style="padding:12px 16px; color:#666;">@(string.IsNullOrEmpty(r.Lugar) ? "—" : r.Lugar)</td>
                            <td style="padding:12px 16px;">
                                @if (!string.IsNullOrEmpty(r.Enlace))
                                {
                                    <a href="@r.Enlace" target="_blank"
                                       style="background:linear-gradient(90deg,#4fc3a1,#1e8449); color:white; border-radius:7px; padding:6px 12px; font-size:12px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:5px;">
                                        <i class="bi bi-box-arrow-up-right"></i> Unirse
                                    </a>
                                }
                                else
                                {
                                    <span style="color:#aaa; font-size:12px;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
