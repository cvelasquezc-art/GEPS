@model List<GEPS.Models.Evento>
@{
    Layout = "~/Views/Shared/_LayoutInvestigador.cshtml";
    ViewBag.Title = "Eventos";
}

<div style="padding: 8px 0 24px;">

    <div style="margin-bottom:28px;">
        <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
            <i class="bi bi-calendar-event"></i> Eventos
        </h2>
        <p style="font-size:13px; color:#888; margin:0;">Eventos registrados en los proyectos de tu semillero</p>
        <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
    </div>

    <div style="background:white; border-radius:16px; padding:24px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">

        @if (Model.Count == 0)
        {
            <div style="text-align:center; padding:60px 20px;">
                <div style="width:64px; height:64px; background:#f0f4f8; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                    <i class="bi bi-calendar-event" style="font-size:28px; color:#aaa;"></i>
                </div>
                <p style="font-size:14px; color:#aaa; margin:0;">No hay eventos registrados en tu semillero.</p>
            </div>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:linear-gradient(90deg,#0d2f5e,#1a5276); color:white;">
                        <th style="padding:12px 16px; font-weight:600; border-radius:8px 0 0 0;">Nombre</th>
                        <th style="padding:12px 16px; font-weight:600;">Tipo</th>
                        <th style="padding:12px 16px; font-weight:600;">Fecha</th>
                        <th style="padding:12px 16px; font-weight:600;">Lugar</th>
                        <th style="padding:12px 16px; font-weight:600; border-radius:0 8px 0 0;">Organizador</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0;">
                            <td style="padding:12px 16px; color:#0d2f5e; font-weight:600;">@ev.Nombre</td>
                            <td style="padding:12px 16px;">
                                <span style="background:#e8f4fd; color:#1a5276; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600;">
                                    @ev.Tipo
                                </span>
                            </td>
                            <td style="padding:12px 16px; color:#666;">@ev.Fecha.ToString("dd/MM/yyyy")</td>
                            <td style="padding:12px 16px; color:#666;">@(string.IsNullOrEmpty(ev.Lugar) ? "—" : ev.Lugar)</td>
                            <td style="padding:12px 16px; color:#666;">@(string.IsNullOrEmpty(ev.NombreOrganizador) ? "—" : ev.NombreOrganizador)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
