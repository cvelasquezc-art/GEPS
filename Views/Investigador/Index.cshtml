@{
    Layout = "~/Views/Shared/_LayoutInvestigador.cshtml";
    ViewBag.Title = "Panel Investigador";
}

<div style="padding: 8px 0 24px;">

    @if (TempData["Exito"] != null)
    {
        <div style="background:#d5f5e3; color:#1e8449; border-radius:10px; padding:12px 16px; font-size:13px; margin-bottom:20px; border-left:4px solid #1e8449;">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    @if (ViewBag.SinSemillero != null && ViewBag.SinSemillero == true)
    {
        <div style="text-align:center; padding:80px 20px;">
            <div style="width:80px; height:80px; background:#fef9e7; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">
                <i class="bi bi-exclamation-triangle" style="font-size:36px; color:#d4ac0d;"></i>
            </div>
            <h3 style="font-size:20px; font-weight:700; color:#0d2f5e; margin-bottom:8px;">Sin semillero asignado</h3>
            <p style="font-size:14px; color:#888;">Aún no has sido asignado a un semillero. Contacta al líder o administrador del sistema.</p>
        </div>
    }
    else
    {
        var semillero = ViewBag.Semillero as GEPS.Models.Semillero;
        var lider = ViewBag.Lider as GEPS.Models.Usuario;

        <!-- Bienvenida -->
        <div style="margin-bottom:28px;">
            <h2 style="font-size:22px; font-weight:700; color:#0d2f5e; margin-bottom:4px;">
                Bienvenido, @Session["Nombre"] 👋
            </h2>
            <p style="font-size:13px; color:#888; margin:0;">
                Semillero: <strong style="color:#1a5276;">@semillero.Nombre</strong> — @semillero.LineaInvestigativa
            </p>
            <div style="width:40px; height:3px; background:#4fc3a1; border-radius:2px; margin-top:10px;"></div>
        </div>

        <!-- Tarjetas resumen -->
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:32px;">

            <div style="background:white; border-radius:16px; padding:24px 20px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
                <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(26,82,118,0.06);"></div>
                <div style="width:44px; height:44px; background:#e8f4fd; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:12px;">
                    <i class="bi bi-kanban" style="font-size:20px; color:#1a5276;"></i>
                </div>
                <div style="font-size:32px; font-weight:900; color:#0d2f5e; line-height:1;">@ViewBag.TotalProyectos</div>
                <div style="font-size:12px; color:#888; margin-top:4px;">Total proyectos</div>
            </div>

            <div style="background:white; border-radius:16px; padding:24px 20px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
                <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(30,132,73,0.06);"></div>
                <div style="width:44px; height:44px; background:#d5f5e3; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:12px;">
                    <i class="bi bi-play-circle" style="font-size:20px; color:#1e8449;"></i>
                </div>
                <div style="font-size:32px; font-weight:900; color:#1e8449; line-height:1;">@ViewBag.ProyectosActivos</div>
                <div style="font-size:12px; color:#888; margin-top:4px;">En ejecución</div>
            </div>

            <div style="background:white; border-radius:16px; padding:24px 20px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
                <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(79,195,161,0.06);"></div>
                <div style="width:44px; height:44px; background:#e8f8f5; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:12px;">
                    <i class="bi bi-camera-video" style="font-size:20px; color:#4fc3a1;"></i>
                </div>
                <div style="font-size:32px; font-weight:900; color:#4fc3a1; line-height:1;">@ViewBag.TotalReuniones</div>
                <div style="font-size:12px; color:#888; margin-top:4px;">Reuniones</div>
            </div>

            <div style="background:white; border-radius:16px; padding:24px 20px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; position:relative; overflow:hidden;">
                <div style="position:absolute; top:-20px; right:-20px; width:80px; height:80px; border-radius:50%; background:rgba(146,43,33,0.06);"></div>
                <div style="width:44px; height:44px; background:#fde8e8; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:12px;">
                    <i class="bi bi-calendar-event" style="font-size:20px; color:#e74c3c;"></i>
                </div>
                <div style="font-size:32px; font-weight:900; color:#e74c3c; line-height:1;">@ViewBag.TotalEventos</div>
                <div style="font-size:12px; color:#888; margin-top:4px;">Eventos</div>
            </div>

        </div>

        <!-- Info del líder -->
        <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee; margin-bottom:24px;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:16px;">
                <i class="bi bi-person-badge"></i> Líder de tu semillero
            </h5>
            @if (lider != null)
            {
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:48px; height:48px; background:#e8f4fd; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <i class="bi bi-person-badge" style="font-size:22px; color:#1a5276;"></i>
                    </div>
                    <div>
                        <div style="font-size:15px; font-weight:700; color:#0d2f5e;">@lider.Nombre</div>
                        <div style="font-size:12px; color:#888; margin-top:2px;">
                            <i class="bi bi-envelope"></i> @lider.Correo
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p style="font-size:13px; color:#888; margin:0;">
                    <i class="bi bi-info-circle"></i> Este semillero aún no tiene un líder asignado.
                </p>
            }
        </div>

        <!-- Accesos rápidos -->
        <div style="background:white; border-radius:16px; padding:24px 28px; box-shadow:0 2px 16px rgba(0,0,0,0.07); border:1px solid #eee;">
            <h5 style="font-size:15px; font-weight:700; color:#0d2f5e; margin-bottom:6px;">
                <i class="bi bi-lightning-charge"></i> Accesos rápidos
            </h5>
            <p style="font-size:12px; color:#aaa; margin-bottom:20px;">Consulta la información de tu semillero</p>

            <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px;">

                <a href="/Investigador/Semillero"
                   style="background:linear-gradient(135deg,#0d2f5e,#1a5276); border-radius:12px; padding:18px 14px; text-decoration:none; display:flex; flex-direction:column; gap:8px;">
                    <div style="width:36px; height:36px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-diagram-3" style="font-size:16px; color:white;"></i>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:700; color:white;">Mi semillero</div>
                        <div style="font-size:10px; color:rgba(255,255,255,0.65); margin-top:2px;">Ver información</div>
                    </div>
                </a>

                <a href="/Investigador/Proyectos"
                   style="background:linear-gradient(135deg,#1e8449,#27ae60); border-radius:12px; padding:18px 14px; text-decoration:none; display:flex; flex-direction:column; gap:8px;">
                    <div style="width:36px; height:36px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-kanban" style="font-size:16px; color:white;"></i>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:700; color:white;">Proyectos</div>
                        <div style="font-size:10px; color:rgba(255,255,255,0.65); margin-top:2px;">Ver proyectos</div>
                    </div>
                </a>

                <a href="/Investigador/Reuniones"
                   style="background:linear-gradient(135deg,#4fc3a1,#1e8449); border-radius:12px; padding:18px 14px; text-decoration:none; display:flex; flex-direction:column; gap:8px;">
                    <div style="width:36px; height:36px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-camera-video" style="font-size:16px; color:white;"></i>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:700; color:white;">Reuniones</div>
                        <div style="font-size:10px; color:rgba(255,255,255,0.65); margin-top:2px;">Ver reuniones</div>
                    </div>
                </a>

                <a href="/Investigador/Eventos"
                   style="background:linear-gradient(135deg,#922b21,#e74c3c); border-radius:12px; padding:18px 14px; text-decoration:none; display:flex; flex-direction:column; gap:8px;">
                    <div style="width:36px; height:36px; background:rgba(255,255,255,0.15); border-radius:8px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-calendar-event" style="font-size:16px; color:white;"></i>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:700; color:white;">Eventos</div>
                        <div style="font-size:10px; color:rgba(255,255,255,0.65); margin-top:2px;">Ver eventos</div>
                    </div>
                </a>

            </div>
        </div>
    }
</div>

